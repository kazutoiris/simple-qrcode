{
  "name": "qr-code-extension",
  "description": "QR Code Generator and Scanner Extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "eslint . && wxt build",
    "build:firefox": "eslint . && wxt build -b firefox",
    "lint": "eslint .",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "eslint": "^10.6.0"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
